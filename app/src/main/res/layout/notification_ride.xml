<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/uruj_black">

    <!-- Row 1: huge speed (left) + huge HR (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|bottom">

            <TextView
                android:id="@+id/notif_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/uruj_neon_cyan"
                android:textSize="38sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/notif_speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notif_speed_unit"
                android:textColor="@color/uruj_muted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|bottom">

            <TextView
                android:id="@+id/notif_hr_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notif_hr_placeholder"
                android:textColor="@color/uruj_neon_magenta"
                android:textSize="38sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/notif_hr_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notif_hr_unit"
                android:textColor="@color/uruj_muted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: distance, time, pause indicator, HR freshness -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/notif_distance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 km"
            android:textColor="@color/uruj_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  •  "
            android:textColor="@color/uruj_divider"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notif_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00:00"
            android:textColor="@color/uruj_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/notif_paused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/notif_paused"
            android:textColor="@color/uruj_neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notif_hr_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/uruj_muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>
</LinearLayout>
